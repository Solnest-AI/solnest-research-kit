# Research Kit (Solnest AI): your keys live ONLY in this file, on your computer.
# Claude never reads these values into the chat and never prints them.
# Paste each value right after the = sign. No quotes, no spaces. Save the file.
# Claude trims this file to just the tools you pick. Sign-in tools need nothing here.

# ==== firecrawl ====
# Firecrawl: https://www.firecrawl.dev/app/api-keys (starts with fc-)
FIRECRAWL_API_KEY=

# ==== brave-search ====
# Brave Search API: https://api-dashboard.search.brave.com (API Keys)
BRAVE_API_KEY=

# ==== exa ====
# Exa: https://dashboard.exa.ai/api-keys
EXA_API_KEY=

# ==== tavily ====
# Tavily: https://app.tavily.com (the key is on your dashboard home)
TAVILY_API_KEY=

# ==== apify ====
# Optional. Only the Reddit search inside deep-internet-research and reddit-search uses this.
# The Apify MCP itself uses a browser sign-in and needs nothing here.
# Apify Console > Settings > API & Integrations: https://console.apify.com/settings/integrations
APIFY_TOKEN=

# ==== github ====
# GitHub fine-grained personal access token: https://github.com/settings/personal-access-tokens
GITHUB_PAT=
